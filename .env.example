# Telegram Bot
BOT_TOKEN=your-bot-token-from-botfather

# Telegram API (for local Bot API server)
TELEGRAM_API_ID=your-api-id-from-my-telegram-org
TELEGRAM_API_HASH=your-api-hash-from-my-telegram-org

# Local Bot API server base URL (used by grammY)
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081

# Database
DATABASE_URL=postgresql://bot:bot_password@postgres:5432/ytbot?schema=public

# Access control — comma-separated Telegram user IDs
ALLOWED_USER_IDS=123456789

# Limits
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_USER_PER_DAY=10
MAX_PLAYLIST_ITEMS=25
MAX_VIDEO_DURATION_SECONDS=7200
MAX_FILE_SIZE_BYTES=2147483648
JOB_TIMEOUT_SECONDS=1800
MIN_DISK_SPACE_BYTES=1073741824
DOWNLOAD_DIR=./downloads

# Optional: Path to Netscape-format cookies.txt file for yt-dlp authentication
# ⚠️ SECURITY WARNING:
# 1. NEVER commit your cookies.txt to version control (it is ignored in .gitignore).
# 2. Use a dedicated, disposable Google/YouTube account — NEVER your primary personal account!
#    If YouTube flags or suspends automated requests, your main Google account could be affected.
# COOKIES_PATH=./cookies.txt
